# Database (TiDB Cloud or local MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=esl_booking
DB_PORT=3306
DB_SSL=false

# JWT Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Super Admin credentials (set on first run)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Frontend URL (required in production for CORS)
FRONTEND_URL=http://localhost:3000

# Where the manual approval gate sits.
#   unset (default) - new companies register as 'pending': they can log in and set
#                     up immediately, but cannot invite real students until a super
#                     admin approves them. Approval is requested at the invite step.
#   true            - skip review entirely; new companies can invite students at once.
# 'pending' does NOT block login or setup — see resolveCompanyGate in authRoutes.js.
# AUTO_APPROVE_COMPANIES=true

# SMTP (optional - leave empty to log reset links to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Web Push (required for push notifications — without these the server stores and
# emits notifications normally, but sendPushToUser() no-ops and no device is woken.
# Generate a keypair with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Sentry (optional)
SENTRY_DSN=
LOG_LEVEL=info

# Node environment
NODE_ENV=development
